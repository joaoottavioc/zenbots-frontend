# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# terraform
**/.terraform/
*.tfstate
*.tfstate.backup

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code IDE configs — personal permissions/settings, not shared.
.claude/settings.local.json
.claude/settings.json

# Internal planning + tech-debt backlogs (kept local, not pushed to the
# public portfolio repo — they enumerate ongoing work, open security
# findings, and strategic decisions that don't belong in a public history).
plan/
tech_debt/
CLAUDE.md

# Documentation (generated/internal, not tracked).
docs/
